# ArivuPath backend environment configuration.
# Copy to `.env` and fill in. NEVER commit a real `.env`.

# --- App ---
APP_ENV=development
# Secret used to sign JWTs. Generate a long random string in real deployments.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# --- Storage backend: "local" (SQLite + JSON seed) or "aws" (DynamoDB + S3) ---
STORAGE_BACKEND=local
# Local SQLite file path (used when STORAGE_BACKEND=local).
SQLITE_PATH=./arivupath.db
# Root directory of approved curriculum content.
CONTENT_DIR=./content

# --- Amazon Bedrock (required for live AI; agents are disabled if unset) ---
# Credentials are resolved by boto3 from env vars, shared config, or IAM role.
# Do NOT hardcode credentials anywhere in source.
AWS_REGION=us-east-1
# Bedrock model id. Example: a Claude model enabled in your account/region.
# Left blank by default so the app does not pretend AI is available.
BEDROCK_MODEL_ID=
# Set to "1" only after confirming Bedrock access; gates the /learn, /practice AI calls.
BEDROCK_ENABLED=0

# --- AWS storage (used only when STORAGE_BACKEND=aws) ---
DDB_USERS_TABLE=ArivuPathUsers
DDB_PROGRESS_TABLE=ArivuPathProgress
DDB_ASSESSMENTS_TABLE=ArivuPathAssessments
S3_CONTENT_BUCKET=
